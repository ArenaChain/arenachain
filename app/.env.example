# Copy to .env.local. Server-side values: paths to keypair files, never the keys themselves.
TREASURY_KEYPAIR=~/.config/solana/arenachain-devnet.json
GAME_SERVER_KEYPAIR=~/.config/solana/arenachain-devnet-server.json
SOLANA_RPC_URL=https://api.devnet.solana.com
FAUCET_COOLDOWN_HOURS=24
FAUCET_SOL_TOPUP_LAMPORTS=20000000
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Lets the "Simulated CS2 server" buttons sign results for any visitor. Demo only: never set this
# on a deployment whose GAME_SERVER_KEYPAIR is a real result-service key.
SIMULATED_SERVER=enabled
